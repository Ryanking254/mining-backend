# Server
PORT=8080
# Comma-separated list of origins allowed to call the API (Vite dev + production)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- TiDB Cloud / MySQL connection (option A: discrete vars) ---
DB_HOST=localhost
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=mining_ledger
# Set to "true" for TiDB Cloud (it requires TLS). Leave "false" for local MySQL/MariaDB.
DB_SSL=true

# --- Option B (alternative): full connection URL ---
# If set, this takes precedence over the discrete vars above.
# TiDB Cloud example: mysql://<user>:<password>@<host>:4000/<db>?sslaccept=strict
# DATABASE_URL=

# If 1, run CREATE TABLE IF NOT EXISTS on boot (safe for TiDB). Set to 0 to manage schema manually.
AUTO_MIGRATE=1
